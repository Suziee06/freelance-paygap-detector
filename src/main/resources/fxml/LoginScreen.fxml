<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.freelancedetector.ui.controller.LoginController" style="-fx-background-color: transparent;">
    
    <!-- TOP NAV IMAGICA STYLE -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" style="-fx-padding: 30 50 20 50;">
            <Label text="◯ Detector" styleClass="imagica-logo"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="🌓 Theme" styleClass="imagica-enterprise-btn" onAction="#toggleTheme"/>
        </HBox>
    </top>

    <!-- CENTER IMAGICA SEARCH AREA -->
    <center>
        <VBox alignment="CENTER" spacing="12.0">
            <Label text="Freelance Pay Gap Detector" textAlignment="CENTER" styleClass="imagica-title"/>
            
            <Region prefHeight="40" />
            
            <Label fx:id="statusLabel" textFill="red"/>
            
            <!-- Identical hollow pill format -->
            <VBox spacing="15" alignment="CENTER" maxWidth="450">
                <TextField fx:id="emailField" promptText="adamdriver@gmail.com" styleClass="imagica-input" alignment="CENTER"/>
                <PasswordField fx:id="passwordField" promptText="Secure Password" styleClass="imagica-input" alignment="CENTER"/>
                <Button fx:id="loginButton" text="Login" maxWidth="Infinity" onAction="#handleLogin" styleClass="imagica-primary-button"/>
                <Hyperlink text="Create an account" onAction="#goToRegister" styleClass="imagica-demo-link" style="-fx-padding: 30 0 0 0;"/>
                <ProgressIndicator fx:id="loadingSpinner" visible="false" maxWidth="20"/>
            </VBox>
        </VBox>
    </center>
    
</BorderPane>
