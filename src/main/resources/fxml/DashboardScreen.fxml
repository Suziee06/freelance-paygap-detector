<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.freelancedetector.ui.controller.DashboardController">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #333333;">
            <Label fx:id="welcomeLabel" text="Welcome, User!" textFill="WHITE" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    
    <left>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #eeeeee;" prefWidth="150">
            <Button text="Dashboard" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
            <Button text="Add Project" maxWidth="Infinity" onAction="#goToAddProject"/>
            <Button text="My Projects" maxWidth="Infinity" onAction="#goToMyProjects"/>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 30;" alignment="CENTER">
            <ProgressIndicator fx:id="loadingSpinner" visible="false"/>
            
            <HBox spacing="20" alignment="CENTER">
                <VBox style="-fx-background-color: #e3f2fd; -fx-padding: 20;" prefWidth="180">
                    <Label text="Total Projects" style="-fx-font-weight: bold;"/>
                    <Label fx:id="totalProjectsLabel" text="..." style="-fx-font-size: 24px;"/>
                </VBox>
                <VBox style="-fx-background-color: #fff3e0; -fx-padding: 20;" prefWidth="180">
                    <Label text="Pending Payments" style="-fx-font-weight: bold;"/>
                    <Label fx:id="pendingPaymentsLabel" text="..." style="-fx-font-size: 24px;"/>
                </VBox>
            </HBox>
            
            <HBox spacing="20" alignment="CENTER">
                <VBox style="-fx-background-color: #e8f5e9; -fx-padding: 20;" prefWidth="180">
                    <Label text="Average Risk" style="-fx-font-weight: bold;"/>
                    <Label fx:id="avgRiskLabel" text="..." style="-fx-font-size: 24px;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffebee; -fx-padding: 20;" prefWidth="180">
                    <Label text="Critical Projects" style="-fx-font-weight: bold;"/>
                    <Label fx:id="criticalProjectsLabel" text="..." style="-fx-font-size: 24px;" textFill="RED"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
