<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.freelancedetector.ui.controller.DashboardController">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="dashboard-top-bar" style="-fx-padding: 15;">
            <Label fx:id="welcomeLabel" text="Welcome, User!" styleClass="header-label" style="-fx-font-size: 18px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="🌓 Theme" styleClass="theme-button" onAction="#toggleTheme"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    
    <left>
        <VBox spacing="10" styleClass="dashboard-sidebar" style="-fx-padding: 20;" prefWidth="200">
            <Button text="Dashboard" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: -accent-blue; -fx-font-weight: bold;"/>
            <Button text="+ Add Project" maxWidth="Infinity" onAction="#goToAddProject"/>
            <Button text="My Projects" maxWidth="Infinity" onAction="#goToMyProjects"/>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>
    
    <center>
        <VBox spacing="30" style="-fx-padding: 40;" alignment="CENTER">
            <Label text="Overview" styleClass="header-label"/>
            <ProgressIndicator fx:id="loadingSpinner" visible="false"/>
            
            <HBox spacing="30" alignment="CENTER">
                <VBox styleClass="summary-card" prefWidth="220" alignment="CENTER">
                    <Label text="Total Projects" styleClass="secondary-label"/>
                    <Label fx:id="totalProjectsLabel" text="..." styleClass="header-label" style="-fx-font-size: 32px;"/>
                </VBox>
                <VBox styleClass="summary-card" prefWidth="220" alignment="CENTER">
                    <Label text="Pending Payments" styleClass="secondary-label"/>
                    <Label fx:id="pendingPaymentsLabel" text="..." styleClass="header-label" style="-fx-font-size: 32px; -fx-text-fill: -accent-purple;"/>
                </VBox>
            </HBox>
            
            <HBox spacing="30" alignment="CENTER">
                <VBox styleClass="summary-card" prefWidth="220" alignment="CENTER">
                    <Label text="Average Risk" styleClass="secondary-label"/>
                    <Label fx:id="avgRiskLabel" text="..." styleClass="header-label" style="-fx-font-size: 32px;"/>
                </VBox>
                <VBox styleClass="summary-card" prefWidth="220" alignment="CENTER">
                    <Label text="Critical Projects" styleClass="secondary-label"/>
                    <Label fx:id="criticalProjectsLabel" text="..." styleClass="header-label" style="-fx-font-size: 32px; -fx-text-fill: red;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
